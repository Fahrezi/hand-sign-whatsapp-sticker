PORT=3000
# comma-separated origins allowed to call the API
WEB_ORIGIN=http://localhost:5173
# OAuth 2.0 Client ID (Web application) from Google Cloud Console — same value as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=
# local: `docker compose up -d` at repo root
DATABASE_URL=postgresql://hand_sign:hand_sign@localhost:5432/hand_sign
# custom hand signs each user may create
MAX_SIGNS_PER_USER=5
# trace | debug | info | warn | error | silent (default: debug in dev, info in prod)
LOG_LEVEL=
# set to the number of proxy hops (usually 1) when deployed behind a reverse proxy
TRUST_PROXY=
# Cloudflare R2 for uploaded stickers — set all five or none (none = store on local disk, dev only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# public base URL of the bucket: r2.dev URL or custom domain, e.g. https://cdn.example.com
R2_PUBLIC_URL=
# local-disk upload folder when R2 is not set (default: ./uploads)
UPLOADS_DIR=
