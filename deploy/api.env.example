# Copy to deploy/api.env and `chmod 600 api.env`. Runtime env for the API container.
# NODE_ENV, PORT and TRUST_PROXY are set in docker-compose.yml.

# web app origin(s), comma-separated. Must be the same site as the API subdomain
# (e.g. https://handsignsticker.luthfiwork.my.id + handsign-api.luthfiwork.my.id) or the session cookie is not sent.
WEB_ORIGIN=https://handsignsticker.luthfiwork.my.id
GOOGLE_CLIENT_ID=
# new value for production: `openssl rand -base64 48`
JWT_SECRET=
# Supabase session pooler (port 5432)
DATABASE_URL=
MAX_SIGNS_PER_USER=5
LOG_LEVEL=info
# required in production — the container disk is wiped on every rebuild
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
